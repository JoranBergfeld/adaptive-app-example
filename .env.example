# Copy to .env, then provide values for Azure deployment.
POSTGRES_PASSWORD=shop-local-only
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=adaptive-shop-demo
AZURE_LOCATION=eastus
KEY_VAULT_NAME=
FRONT_DOOR_PROFILE_NAME=
# Defaults to shop; choose an unused endpoint name if Azure reports a conflict.
FRONT_DOOR_ENDPOINT_NAME=
# Leave these blank to use scripts/05-create-service-principal.sh.
ARO_SERVICE_PRINCIPAL_CLIENT_ID=
ARO_SERVICE_PRINCIPAL_CLIENT_SECRET=
ARO_SERVICE_PRINCIPAL_OBJECT_ID=
RED_HAT_PULL_SECRET_FILE=
RECIPE_REF=main
GITHUB_REPOSITORY=JoranBergfeld/adaptive-app-example
OPENSHIFT_VERSION=
